{
    "name": "axitrace/prestashop-tracking",
    "description": "AxiTrace server-side conversion tracking for PrestaShop 8.1 and 9.x.",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "homepage": "https://axitrace.com/docs/integrations/prestashop",
    "authors": [
        {
            "name": "AxiTrace",
            "homepage": "https://axitrace.com"
        }
    ],
    "support": {
        "docs": "https://axitrace.com/docs/integrations/prestashop",
        "source": "https://github.com/axitrace/axitrace-prestashop-module"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "~2.2.14",
        "phpunit/phpunit": "^10.5",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Axitrace\\PrestaShop\\": "src/"
        },
        "classmap": [
            "axitrace.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Axitrace\\PrestaShop\\Tests\\": "tests/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
