# Fallback: level 8 on the PrestaShop-independent code, for a machine without the PrestaShop source.
# The PrestaShop-bound classes (main class, adapters, service wiring) are analysed by
# phpstan-prestashop.neon against PrestaShop 8.1.7 (_PS_ROOT_DIR_); CI runs that one and falls back
# to this file only when the PrestaShop source cannot be downloaded.
parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - src/Adapter/PrestaShop*.php
        - src/Adapter/PhpEncryptionCipher.php
        - src/Adapter/ModuleTranslator.php
        - src/ModuleServices.php
        - src/*/index.php
        - src/index.php
    bootstrapFiles:
        - tests/bootstrap.php
